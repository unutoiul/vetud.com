# Medusa backend (Railway URL in production)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Printed by the backend seed, or Medusa Admin > Settings > Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxx

# Public site URL (used for metadata, sitemap and links)
NEXT_PUBLIC_BASE_URL=http://localhost:8000
# Country used when a visitor's country is not sold to
NEXT_PUBLIC_DEFAULT_COUNTRY=us

# Optional: shown on the order confirmation page (the email always includes them)
NEXT_PUBLIC_PAYMENT_BANK_DETAILS=
