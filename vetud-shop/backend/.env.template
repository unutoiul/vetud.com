# --- Core -------------------------------------------------------------------
DATABASE_URL=postgres://vetud:vetud@localhost:5432/vetud_medusa
REDIS_URL=redis://localhost:6379
# Generate long random strings for production (e.g. `openssl rand -hex 32`)
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=

# --- CORS --------------------------------------------------------------------
# Storefront origin(s): npm dev uses 8000; vercel dev defaults to 3000.
# Production: include https://pep.company and https://www.pep.company in both store and auth CORS.
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,http://localhost:3000

# --- Deployment (Railway) ----------------------------------------------------
# "server" for the API/admin service, "worker" for the background worker, "shared" locally.
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
# Public URL of the Medusa server (used by the admin dashboard build).
MEDUSA_BACKEND_URL=http://localhost:9000
# Offline reviewed-content imports only; keep the export outside the public static folder.
# CONTENT_TRANSLATIONS_FILE=/private/path/reviewed-database-import.json

# --- PayGate hosted card / crypto checkout (optional) -------------------------
PAYGATE_ENABLED=false
PAYGATE_API_DOMAIN=api-vetudcom-6a438e9ca8f87c5e13025476.paygate.to
# Keep the provider-hosted domain unless a custom checkout domain is verified live.
PAYGATE_CHECKOUT_DOMAIN=checkout.paygate.to
# Public EVM address, never an exchange deposit address or private key.
PAYGATE_CARD_WALLET=
# Network-to-address JSON, e.g. {"evm":"0x...","btc":"bc1..."}; exact real addresses required.
PAYGATE_CRYPTO_WALLETS={}
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYGATE_CALLBACK_SECRET=
# Default: full invoice USD value. Net card payouts below this require review.
# An explicitly configured 0.90–1.00 policy may allow documented provider fees.
PAYGATE_CARD_MIN_NET_RATIO=1

# --- Search (Meilisearch) ------------------------------------------------------
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=vetud-dev-master-key-change-me

# --- Email (Resend) ------------------------------------------------------------
# Leave RESEND_API_KEY empty locally to log emails to the console instead of sending.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (onboarding@resend.dev works for testing).
RESEND_FROM_EMAIL="Vetud Peptides <``````@vetud.example>"
# Receives new-order alerts and contact-form messages.
STORE_OWNER_EMAIL=owner@vetud.example
# Used for email links and MakePay returns. Production: https://www.pep.company.
STOREFRONT_URL=http://localhost:8000

# --- Manual payment instructions (shown in the order confirmation email) -------
PAYMENT_INSTRUCTIONS="Pay by bank transfer within 3 business days. Use your order number as the payment reference."
PAYMENT_BANK_DETAILS="Account name: Vetud Peptides | IBAN: XX00 0000 0000 0000 | BIC: XXXXXXXX"

# --- MakePay crypto checkout (optional, off while empty) ------------------------
# Generate with: openssl rand -base64 32. Keep it secret and never change it afterwards
# (it encrypts the MakePay connection; losing it means reconnecting in Admin).
MAKEPAY_ENCRYPTION_KEY=
# Settlement currency for MakePay payments.
MAKEPAY_SETTLEMENT_CURRENCY=USDT
# Exact hosted-checkout origin; keep aligned with NEXT_PUBLIC_MAKEPAY_CHECKOUT_ORIGIN.
# Current production endpoint: https://pay.makecrypto.io
MAKEPAY_CHECKOUT_ORIGIN=https://pay.makecrypto.io

# --- PayPal (Medusa plugin; connect in Admin > Settings > PayPal) --------------
# Stable random secret shared by server and worker; do not rotate without re-encrypting credentials.
PAYPAL_ENCRYPTION_KEY=
PAYPAL_ENCRYPTION_STRICT=true
# Use each cart's currency instead of the module's default EUR override.
PAYPAL_MULTI_CURRENCY=true
PAYPAL_SEND_SHIPPING_ADDRESS=true
# Currencies for the PayPal activation script; archived regions are excluded.
PAYPAL_REGION_CURRENCIES=usd,eur,gbp
# Leave unset/false for a connection check and dry run. Live credentials are required to apply.
PAYPAL_SETUP_APPLY=false

# --- NMI card / bank checkout (optional; MakePay remains available) ------------
# Merchant approval and an NMI gateway are separate requirements. No live defaults.
NMI_ENABLED=false
NMI_SECURITY_KEY=
NMI_TOKENIZATION_KEY=
NMI_WEBHOOK_SECRET=
NMI_ENVIRONMENT=sandbox
# Must match the gateway account, e.g. usd or eur. Other cart currencies are rejected.
NMI_ACCOUNT_CURRENCY=
# ISO country of the merchant, not the shopper (e.g. US, GB, DE).
NMI_MERCHANT_COUNTRY=
# Enable only after the acquirer provisions these and sandbox checks pass.
NMI_ACH_ENABLED=false
NMI_WALLETS_ENABLED=false

# The storefront address that product images are served from (default https://www.vetud.com).
# Set it to the shop's own domain when the shop moves.
# PRODUCT_IMAGE_ORIGIN=http://localhost:8000
