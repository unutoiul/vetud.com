# --- Core -------------------------------------------------------------------
DATABASE_URL=postgres://vetud:vetud@localhost:5433/vetud_education
REDIS_URL=redis://localhost:6380
PORT=9100
# Generate long random strings for production (e.g. `openssl rand -hex 32`).
# Never reuse the shop's values.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=

# --- CORS --------------------------------------------------------------------
# Education storefront origin(s), comma separated. In production: https://vetud.com,https://www.vetud.com
STORE_CORS=http://localhost:8100
ADMIN_CORS=http://localhost:5173,http://localhost:9100
AUTH_CORS=http://localhost:5173,http://localhost:9100,http://localhost:8100

# --- Deployment (Railway) ----------------------------------------------------
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
# Public URL of this Medusa server (used by the admin dashboard build and for uploaded photos).
MEDUSA_BACKEND_URL=http://localhost:9100

# --- Email (Resend) ------------------------------------------------------------
# Leave RESEND_API_KEY empty locally to log emails to the console instead of sending.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
RESEND_FROM_EMAIL="VETUD <contact@vetud.com>"
# Receives contact-form messages and expert applications.
STORE_OWNER_EMAIL=contact@vetud.com
# Used for links in emails and in the Admin pages.
STOREFRONT_URL=http://localhost:8100
# ID of the published "email-list-confirm" template in Resend (variables: HEADING, MESSAGE,
# BUTTON_LABEL, CONFIRM_URL, FOOTNOTE). Sign-ups fail to send until this is set.
RESEND_EMAIL_LIST_CONFIRM_TEMPLATE_ID=
