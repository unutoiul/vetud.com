{
  "name": "vetud-education-backend",
  "version": "0.0.1",
  "description": "VETUD education backend (Medusa): community, comments, accounts and the email list",
  "author": "Vetud Peptides",
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "db:migrate": "medusa db:migrate",
    "predeploy": "medusa db:migrate",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "start:railway": "cd .medusa/server && npm install && npm run predeploy && npm run start"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/caching": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/dashboard": "2.21.2",
    "@medusajs/draft-order": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@mikro-orm/cli": "6.6.14",
    "@mikro-orm/core": "6.6.14",
    "@mikro-orm/knex": "6.6.14",
    "@mikro-orm/migrations": "6.6.14",
    "@mikro-orm/postgresql": "6.6.14",
    "@tanstack/react-query": "5.64.2",
    "multer": "2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "resend": "^6.32.1",
    "sharp": "0.34.4",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "@medusajs/test-utils": "2.21.2",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/multer": "2.0.0",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "prop-types": "^15.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "npm@10.9.3",
  "private": true,
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  }
}
