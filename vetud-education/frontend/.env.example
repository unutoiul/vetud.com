# Education backend (Railway URL in production)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9100
# Medusa Admin > Settings > Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxx

# Public site URL (used for metadata, sitemap and links)
NEXT_PUBLIC_BASE_URL=http://localhost:8100

# The separate shop. While empty, the Shop links are hidden and old shop addresses are not redirected.
NEXT_PUBLIC_SHOP_URL=

# Set to true only at launch. Until then every page answers with noindex.
INDEXING_ENABLED=false

# Set to true about 48 hours after launch. Browsers keep permanent redirects, so they can't be undone.
REDIRECTS_PERMANENT=false
